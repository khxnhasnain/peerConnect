{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "serve:http": "php artisan serve --host=0.0.0.0 --port=8001",
        "serve:proxy": "local-ssl-proxy --source 8443 --target 127.0.0.1:8001 --cert storage/certs/cert.pem --key storage/certs/cert-key.pem --hostname 192.168.1.41",
        "serve:https": "concurrently -n http,https -c blue,green \"npm run serve:http\" \"npm run serve:proxy\""
    },
    "devDependencies": {
        "@tailwindcss/forms": "^0.5.2",
        "@tailwindcss/vite": "^4.0.0",
        "alpinejs": "^3.4.2",
        "autoprefixer": "^10.4.2",
        "axios": "^1.11.0",
        "concurrently": "^9.0.1",
        "local-ssl-proxy": "^2.0.5",
        "laravel-echo": "^2.3.7",
        "laravel-vite-plugin": "^2.0.0",
        "postcss": "^8.4.31",
        "pusher-js": "^8.5.0",
        "tailwindcss": "^3.1.0",
        "vite": "^7.0.7"
    }
}
